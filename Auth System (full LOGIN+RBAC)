const mongoose = require("mongoose");

const User Schema = new mongoose.Schema({
    name: String.
    email: { type: String, unique: true },
    password: String,
        role: {
          type: String,
          enum: ["admin", "reseller", "customer"],
        default: "customer"
        }
}, { timestamps: true });

module.exports = mongoose.model("User", UserSchema);
